# 服务端口
PORT=8787

# 存储目录（默认 api/storage，保存元数据、上传文件与结果文件）
# STORAGE_DIR=storage

# 算法对接模式：mock（内置示例结果）| http（转发真实算法服务）
ALGORITHM_MODE=mock

# 算法服务接口（风险规则引擎）。提交 multipart：taskId / creator / orderFile / invoiceFile
# ALGORITHM_API_URL=http://127.0.0.1:9000/api/v1/risk/analyze
# ALGORITHM_HEALTH_URL=http://127.0.0.1:9000/api/v1/health
# ALGORITHM_API_KEY=
# ALGORITHM_TIMEOUT=180000

# Mock 模式模拟分析耗时（毫秒）
MOCK_DELAY_MS=4500

# 单个上传文件大小上限（字节）
MAX_FILE_SIZE=20971520
